DATABASE_URL="postgresql://neondb_owner:password@ep-lucky-tree-a2sjmpff-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:password@ep-lucky-tree-a2sjmpff.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Shared admin login password.
ADMIN_PASSWORD=""

# HMAC secret for the admin session cookie.
ADMIN_SESSION_SECRET=""

# Separate signing secret for future ticket tokens.
TICKET_SECRET=""

# Bearer token for the scheduled expiry sweep cron endpoint.
CRON_SECRET=

# Pending booking expiry windows.
PENDING_ONLINE_EXPIRY_HOURS="3"
PENDING_DOOR_EXPIRY_HOURS="24"

# Timeout for a WhatsApp ticket send (provider call), in milliseconds.
SEND_TIMEOUT_MS="15000"

# WhatsApp Cloud API credentials (Meta). A send fails closed until set.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Optional: API version (defaults to v21.0).
WHATSAPP_API_VERSION=""

# Optional: template name for business-initiated document messages.
WHATSAPP_TEMPLATE_NAME=""

# Optional: country code (no +) prefixed to local phone numbers before sending.
WHATSAPP_DEFAULT_COUNTRY_CODE=""
