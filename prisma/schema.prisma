// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SeatStatus {
  AVAILABLE
  PENDING
  BOOKED
}

enum CaseType {
  ONLINE_CODE
  PAY_AT_DOOR
  GUEST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats  VenueSeat[]
  events Event[]
}

model VenueSeat {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  row     String
  number  String
  section String?

  eventSeats EventSeat[]

  @@unique([venueId, row, number, section])
}

model Event {
  id          String      @id @default(cuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id])
  name        String
  description String?
  startsAt    DateTime
  status      EventStatus @default(DRAFT)
  slug        String      @unique

  eventSeats EventSeat[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventSeat {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  venueSeatId String
  venueSeat   VenueSeat @relation(fields: [venueSeatId], references: [id])

  status SeatStatus @default(AVAILABLE)

  bookedByName  String?
  bookedByPhone String?
  referenceCode String?
  pendingSince  DateTime?
  expiresAt     DateTime?

  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, venueSeatId])
  @@index([status, expiresAt])
}

model Booking {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  eventSeatId String    @unique
  eventSeat   EventSeat @relation(fields: [eventSeatId], references: [id])

  userName  String
  userPhone String

  caseType CaseType
  status   BookingStatus @default(PENDING)

  referenceCode String? @unique

  confirmedByAdmin String?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  expiresAt        DateTime?

  ticketToken  String?   @unique
  ticketPdfUrl String?
  ticketSentAt DateTime?
  ticketNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
}
