// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELED
}

enum SeatStatus {
  AVAILABLE
  PENDING
  BOOKED
  CANCELED
}

enum CaseType {
  ONLINE_CODE
  PAY_AT_DOOR
  GUEST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections VenueSection[]
  seats    VenueSeat[]
  events   Event[]
}

model VenueSection {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name  String
  price Int

  seats VenueSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@unique([id, venueId])
}

model VenueSeat {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  row       String
  number    String
  sectionId String
  section   VenueSection @relation(fields: [sectionId, venueId], references: [id, venueId])

  eventSeats EventSeat[]

  @@unique([venueId, row, number, sectionId])
  @@unique([id, venueId])
}

model Event {
  id          String      @id @default(cuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id])
  name        String
  description String?
  startsAt    DateTime
  status      EventStatus @default(DRAFT)
  slug        String      @unique

  eventSeats EventSeat[]
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, venueId])
}

model EventSeat {
  id          String @id @default(cuid())
  eventId     String
  venueSeatId String
  venueId     String

  event     Event     @relation(fields: [eventId, venueId], references: [id, venueId], onDelete: Cascade)
  venueSeat VenueSeat @relation(fields: [venueSeatId, venueId], references: [id, venueId])

  status SeatStatus @default(AVAILABLE)

  bookedByName  String?
  bookedByPhone String?
  referenceCode String?
  pendingSince  DateTime?
  expiresAt     DateTime?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, venueSeatId])
  @@unique([eventId, id])
  @@index([status, expiresAt])
}

model Booking {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  eventSeatId String
  eventSeat   EventSeat @relation(fields: [eventId, eventSeatId], references: [eventId, id])

  userName  String
  userPhone String

  caseType CaseType
  status   BookingStatus @default(PENDING)

  referenceCode String? @unique

  confirmedByAdmin String?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  expiresAt        DateTime?

  ticketToken  String?   @unique
  ticketPdfUrl String?
  ticketSentAt DateTime?
  ticketNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
}
